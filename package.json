{
  "name": "project-lantern",
  "version": "1.0.0-rc.19",
  "private": true,
  "type": "module",
  "description": "ExcluSignal: federal vendor exclusion monitoring with auditable evidence and procurement intelligence.",
  "scripts": {
    "analytics:summary": "node --env-file-if-exists=.env scripts/analytics-summary.js",
    "doctor:stripe": "node --env-file-if-exists=.env scripts/doctor-stripe.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "check": "node scripts/check-all.js",
    "start:mock": "DATA_PROVIDER=mock MARKET_PROVIDER=mock node server.js",
    "doctor:sam": "node --env-file-if-exists=.env scripts/doctor-sam.js",
    "doctor:exclusions": "node --env-file-if-exists=.env scripts/doctor-exclusions.js",
    "secret-scan": "node scripts/secret-scan.js",
    "job:daily": "node --env-file-if-exists=.env scripts/daily-job.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "outbox:deliver": "node --env-file-if-exists=.env scripts/deliver-outbox.js",
    "benchmark": "node scripts/benchmark.js",
    "smoke:auth": "node scripts/smoke-auth.js",
    "smoke:scheduler": "node scripts/smoke-scheduler.js",
    "smoke:production": "node scripts/smoke-production.js",
    "release:gate": "npm run check && npm test && npm run smoke:auth && npm run smoke:vendor-watch && npm run smoke:billing && npm run smoke:change-watch && npm run smoke:requirement-delta && npm run smoke:scheduler && npm run smoke:production && npm run smoke:lifecycle && npm run smoke:commercial && npm run secret-scan",
    "smoke:lifecycle": "node scripts/smoke-lifecycle.js",
    "smoke:change-watch": "node scripts/smoke-change-watch.js",
    "smoke:requirement-delta": "node scripts/smoke-requirement-delta.js",
    "smoke:vendor-watch": "node scripts/smoke-vendor-watch.js",
    "smoke:billing": "node scripts/smoke-billing.js",
    "smoke:commercial": "node scripts/smoke-commercial.js"
  },
  "engines": {
    "node": ">=22"
  }
}
